{
  "name": "buio-mobile",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "BuiO Capacitor pilot for Android and iOS",
  "scripts": {
    "prepare:app": "node scripts/prepare.mjs",
    "sync": "npm run prepare:app && cap sync",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "android:debug": "node scripts/android-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs",
    "package": "npm run sync && node scripts/package.mjs",
    "ios:simulator": "npm run sync && node scripts/ios-simulator.mjs",
    "ios:device": "npm run sync && node scripts/ios-device.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/ios": "8.6.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "jszip": "^3.10.1",
    "yaml": "2.9.1"
  }
}
